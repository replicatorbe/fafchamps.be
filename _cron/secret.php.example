<?php
/**
 * secret.php — stockage du token GitHub (NE PAS committer / NE PAS partager).
 *
 * Installation :
 *   cp secret.php.example secret.php
 *   nano secret.php            # remplace la valeur ci-dessous
 *   chmod 600 secret.php
 *
 * Token recommandé : Personal Access Token « classic » avec le SEUL scope
 * read:user  (https://github.com/settings/tokens). Suffisant pour lire le
 * total de contributions (privées comprises) de ton propre compte.
 *
 * Sans secret.php, le cron tourne quand même via une source publique de
 * secours (jogruber) ; avec le token, c'est 100% officiel GitHub.
 *
 * Sécurité :
 *  - La garde CLI ci-dessous renvoie 404 si le fichier est appelé par le web,
 *    sur n'importe quel serveur qui exécute PHP.
 *  - nginx route déjà les .php vers PHP-FPM : un téléchargement donne un
 *    corps VIDE, jamais le token.
 *  - Le vhost (deploy/fafchamps.be.conf) refuse tout le dossier _cron/.
 */

if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }   // jamais via le web

return 'ghp_colle_ton_token_ici';
